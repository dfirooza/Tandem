# Port the WebSocket server listens on
PORT=8787

# Supabase project URL (Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key — bypasses RLS so the server can write on behalf of users.
# NEVER expose this to clients or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Liveblocks secret key (Dashboard -> Project -> API keys). Server-side only.
# If unset, the server runs without the live layer (Supabase writes still work).
LIVEBLOCKS_SECRET_KEY=sk_your-liveblocks-secret-key

# Anon (publishable) key — used by scripts/get-token.mjs to sign in as a user.
SUPABASE_ANON_KEY=your-anon-key

# Anthropic API key — session summarization (Stage 11) with Claude Haiku.
# If unset, summarization is disabled; everything else works normally.
ANTHROPIC_API_KEY=sk-ant-your-key
