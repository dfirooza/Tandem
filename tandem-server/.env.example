# Port the WebSocket server listens on
PORT=8787

# Supabase project URL (Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key — bypasses RLS so the server can write on behalf of users.
# NEVER expose this to clients or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Liveblocks secret key (Dashboard -> Project -> API keys). Server-side only.
# If unset, the server runs without the live layer (Supabase writes still work).
LIVEBLOCKS_SECRET_KEY=sk_your-liveblocks-secret-key

# Anon (publishable) key — used by scripts/get-token.mjs to sign in as a user.
SUPABASE_ANON_KEY=your-anon-key

# Anthropic API key — session summarization (Stage 11) with Claude Haiku.
# If unset, summarization is disabled; everything else works normally.
ANTHROPIC_API_KEY=sk-ant-your-key

# ─── e2e test accounts (test/e2e-stage*.mjs) ─────────────────────────────────
# Emails are plain identifiers; the test files fall back to these exact values
# if unset, so you normally only need to set the password.
TANDEM_TEST_EMAIL_A=test-e2e@tandem.dev
TANDEM_TEST_EMAIL_B=test-e2e-b@tandem.dev
TANDEM_TEST_EMAIL_C=test-e2e-c@tandem.dev

# Shared password for the three test accounts. REQUIRED — the tests refuse to
# run without it, deliberately: there is no default, so a real password can
# never end up hardcoded in a test file. Never commit a real value.
TANDEM_TEST_PASSWORD=your-test-account-password
