# Copy this file to .env.local and fill in your Supabase project credentials.
# Find these in your Supabase dashboard under Settings > API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Liveblocks public key (Dashboard -> Project -> API keys).
# Safe to expose to the browser; used to read the live session feed.
NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY=pk_your-liveblocks-public-key

# tandem-server base URL (server-side only, no NEXT_PUBLIC) — used by the
# branch server action to relay branch requests.
TANDEM_SERVER_URL=http://localhost:8787

# tandem-server WebSocket URL for the browser — carries remote session
# control input (Stage 10). Safe to expose; every message is re-verified
# server-side against the current controller.
NEXT_PUBLIC_TANDEM_SERVER_URL=ws://localhost:8787
