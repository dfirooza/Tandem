.claude/worktrees/

# Generated by tandem-cli when run inside this repo (room context file).
TANDEM_MEMORY.md

# Env files — never commit real keys. Each package also ignores its own
# (tandem-server/.gitignore, tandem-web/.gitignore); these root rules are a
# belt-and-braces default so a new package can't leak one by omission.
.env
.env.local
.env.*.local
